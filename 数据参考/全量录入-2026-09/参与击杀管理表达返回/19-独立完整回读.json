    "/skills/tristana_w": {
      "createdAt": "2026-09-06T18:20:41.015015Z",
      "description": "火箭跳跃落地对附近敌人造成魔法伤害并减速。本轮已配置敌方英雄实际落地伤害、40%持续2秒首次减速、普通主动使用的法力/基础冷却/250毫秒施法过程，以及正式参与英雄击杀（击杀或助攻）时重置W。对英雄满层E引爆重置与叠层、减速重施及完整护盾交互继续核定；跳跃路径与附近目标搜索沿既定范围后置，战斗运行未验证。来源：客户端16.17、官方静态资料16.17.1。",
      "gameId": "lol",
      "maxLevel": 5,
      "name": "崔丝塔娜·火箭跳跃",
      "skillCategoryKeys": [
        "common"
      ],
      "skillKey": "tristana_w",
      "sortOrder": 2,
      "status": "ENABLED",
      "updatedAt": "2026-09-20T15:54:58.707711Z"
    },
