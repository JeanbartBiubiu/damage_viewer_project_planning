    "/skills/talon_q": {
      "createdAt": "2026-09-06T18:20:35.316779Z",
      "description": "泰隆戳刺目标单位。如果目标在近战距离之内，那么这次攻击会造成致命伤害。如果目标在近战距离之外，那么泰隆将会跃向他的目标然后戳刺目标。如果这个技能击杀了泰隆的目标，那么就会返还给泰隆一些生命值和冷却时间。（来源：官方中文静态资料16.17.1；数值和机制待补证，变量原样保留。）",
      "gameId": "lol",
      "maxLevel": 5,
      "name": "泰隆·诺克萨斯式外交",
      "skillCategoryKeys": [
        "common"
      ],
      "skillKey": "talon_q",
      "sortOrder": 1,
      "status": "ENABLED",
      "updatedAt": "2026-09-06T18:20:35.316779Z"
    },
