  "locTextsUsed": {
    "zoe_p": {
      "keyName": "烟火四射！",
      "keyTooltip": "在施放一次技能后，佐伊的下次普攻将造成额外的<magicDamage>@PassiveDamage@魔法伤害</magicDamage>。",
      "keyTooltipExtended": "{{Spell_ZoePassive_Tooltip}}<br><br><rules>强化攻击会立刻造成伤害。</rules>"
    },
    "zoe_q": {
      "keyName": "飞星乱入！",
      "keySummary": "佐伊发射一个可在飞行途中由她重新导向的飞弹。飞弹在直线上飞行的路程越远，造成的伤害就会越高。",
      "keyTooltip": "佐伊发射一颗飞星，基于它的飞行距离来对命中的第一个敌人造成不断提升的伤害 -- <magicDamage>@TotalDamageTooltip@到@MaxDamageTooltip@魔法伤害</magicDamage>。<br><br>佐伊可以<recast>再次施放</recast>这个技能来将这个飞弹重新导向到佐伊附近的一个新位置。"
    },
    "zoe_w": {
      "keyName": "窃法巧手",
      "keySummary": "佐伊可以拾取敌方在施放召唤师技能和主动型装备时产生的法术碎片，从而让她自己能够施放一次性的相应技能或效果。在她施放一次召唤师技能的同时，她会获得3颗飞弹来射向距她最近的目标。",
      "keyTooltip": "<spellPassive>被动：</spellPassive>敌人在使用【召唤师技能】或【主动型装备】时会掉落一个技能碎片。特定小兵也会在被佐伊或一名附近的友方英雄击杀后掉落一个技能碎片。佐伊可以拾取这些碎片来使用一次相应技能。<br><br><spellPassive>被动：</spellPassive>当佐伊施放这个技能或任一召唤师技能时，她会获得<speed>@MovementSpeed*100@%移动速度</speed>，持续@MSDuration@秒，并对她近期刚攻击过的目标投出3个飞弹。每颗飞弹造成<magicDamage>@MissileDamageTooltip@魔法伤害</magicDamage>。<br><br><spellActive>主动：</spellActive>施放一次来自佐伊已拾取的技能碎片的技能。",
      "keyTooltipExtendedBelowLine": "<rules>技能碎片会在地上持续40秒。<br>每颗飞弹都会施加<spellName>烟火四射！</spellName></rules>",
      "keyCost": "无消耗"
    },
    "zoe_e": {
      "keyName": "催眠气泡",
      "keySummary": "困倦使目标进入困倦状态，然后陷入昏睡。在昏睡状态下，目标的魔抗会被降低。打醒目标的第一个伤害来源会造成双倍伤害，但有封顶值。",
      "keyTooltip": "佐伊踢出一个气泡，可造成<magicDamage>@TotalDamageTooltip@魔法伤害</magicDamage>，并会在未命中任何单位时如陷阱一般停留。在飞越墙体后，气泡的距离会得到延长。<br><br>如果气泡或陷阱命中了一个敌方英雄，那么她会刷新此技能@CooldownRefresh*100@%冷却时间。<br><br>在一段延迟后，被气泡命中的目标会陷入<status>昏睡</status>状态并降低@PercentPen*100@%<scaleMR>魔法抗性</scaleMR>，持续2秒。攻击和技能在命中目标时都会将其惊醒并造成双倍伤害，最多造成<trueDamage>@BreakDamageTooltip@真实伤害</trueDamage>。<br><br>",
      "keyTooltipExtendedBelowLine": "<rules>在目标陷入<status>昏睡</status>状态之前，会进入<status>困倦</status>状态，被施加不断提升的<status>减速</status>效果(至多可达@DrowsySlow*100@%)。</rules>"
    },
    "zoe_r": {
      "keyName": "折返跃迁",
      "keySummary": "闪烁到附近的一个位置1秒。然后闪烁回去。",
      "keyTooltip": "佐伊传送到附近的一个位置1秒。然后，佐伊会传送回原来的位置。在此期间，佐伊可以攻击和使用技能，但无法移动。",
      "keyTooltipExtendedBelowLine": "<rules>在传送期间，佐伊的视线还可以越过墙体。</rules>"
    }
  },
