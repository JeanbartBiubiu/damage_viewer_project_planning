    {
      "skill": "sett_w",
      "route": "/skills/sett_w",
      "status": 200,
      "data": {
        "createdAt": "2026-09-06T18:20:15.196274Z",
        "description": "瑟提会被动地将他受到的伤害储存为豪意。在施放时，瑟提会释放所有已储存的豪意来提供一层护盾并且重击一个区域，在区域中心造成真实伤害并在区域边缘造成物理伤害。（来源：官方中文静态资料16.17.1；数值和机制待补证，变量原样保留。）",
        "gameId": "lol",
        "maxLevel": 5,
        "name": "瑟提·蓄意轰拳",
        "skillCategoryKeys": [
          "common"
        ],
        "skillKey": "sett_w",
