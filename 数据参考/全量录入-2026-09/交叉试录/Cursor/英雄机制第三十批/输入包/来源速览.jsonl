{"skill":"yone_r","text":{"keyName":{"sourceKey":"Spell_YoneR_Name","text":"封尘绝念斩"},"keySummary":{"sourceKey":"Spell_YoneR_Summary","text":"永恩沿直线进行斩击，闪烁至最后一名敌方英雄身后，并将命中的所有敌人拉向他。"},"keyTooltip":{"sourceKey":"Spell_YoneR_Tooltip","text":"永恩对一条路径上的所有敌人进行打击，造成<physicalDamage>@TooltipDamage@物理伤害</physicalDamage>和<magicDamage>@TooltipDamage@魔法伤害</magicDamage>，传送至命中的最后一名敌方英雄身后，并将命中的所有敌人<status>击飞</status>向永恩。 "},"keyCost":{"sourceKey":"Spell_Cost_NoCost","text":"无消耗"},"keyTooltipExtendedBelowLine":{"sourceKey":"Spell_YoneR_TooltipExtendedBelowLine","text":"<rules>如果没有命中任何敌方英雄，那么永恩将闪烁至技能的最大距离处。</rules>"}},"spellCastTime":0.125,"mCastTime":0.75,"values":[{"name":"BaseDamage","values":[0,200,400,600,800,1000,1200],"__type":"SpellDataValue"},{"name":"ADRatio","values":[0.800000011920929,0.800000011920929,0.800000011920929,0.800000011920929,0.800000011920929,0.800000011920929,0.800000011920929],"__type":"SpellDataValue"},{"name":"BlinkDistanceBehindTarget","values":[200,200,200,200,200,200,200],"__type":"SpellDataValue"},{"name":"Width","values":[225,225,225,225,225,225,225],"__type":"SpellDataValue"},{"name":"RKnockupHeight","values":[0.5,0.5,0.5,0.5,0.5,0.5,0.5],"__type":"SpellDataValue"},{"name":"RKnockupDuration","values":[0.75,0.75,0.75,0.75,0.75,0.75,0.75],"__type":"SpellDataValue"},{"name":"RKnockTowardsSpeed","values":[3000,3000,3000,3000,3000,3000,3000],"__type":"SpellDataValue"},{"name":"RKnockTowardsDampener","values":[0.800000011920929,0.800000011920929,0.800000011920929,0.800000011920929,0.800000011920929,0.800000011920929,0.800000011920929],"__type":"SpellDataValue"}],"calculations":{"Damage":{"mFormulaParts":[{"mDataValue":"BaseDamage","__type":"NamedDataValueCalculationPart"},{"mStat":2,"mStatFormula":2,"mDataValue":"ADRatio","__type":"StatByNamedDataValueCalculationPart"}],"__type":"GameCalculation"},"TooltipDamage":{"mMultiplier":{"mNumber":0.5,"__type":"NumberCalculationPart"},"mModifiedGameCalculation":"Damage","__type":"GameCalculationModified"}},"other":{"