    "/skills/seraphine_r": {
      "createdAt": "2026-09-06T18:20:14.364885Z",
      "description": "萨勒芬妮对命中的敌人造成伤害和魅惑，并在命中友方或敌方英雄时延伸技能距离。已保存基础参数、伤害公式、终极技能分类，以及本来源当前目标无魅惑实例时的首次魅惑身份与期限；首次魅惑只连接敌方英雄实际命中且本次未被法术护盾阻挡的入口。伤害结果、使用成本与过程、施放时间冲突、重施及距离延伸仍待完善；仅队友音符不在本轮1V1范围内。不计整技能管理完整。来源：客户端16.17、官方中英文16.17.1。",
      "gameId": "lol",
      "maxLevel": 3,
      "name": "萨勒芬妮·炫音返场",
      "skillCategoryKeys": [
        "ultimate"
      ],
      "skillKey": "seraphine_r",
      "sortOrder": 4,
      "status": "ENABLED",
      "updatedAt": "2026-09-20T04:25:25.853869Z"
    },
