    "aurelionsol_r": {
      "route": "/skills/aurelionsol_r",
      "method": "GET",
      "status": 200,
      "ok": true,
      "data": {
        "createdAt": "2026-09-06T18:16:29.269698Z",
        "description": "星落：奥瑞利安 · 索尔召唤一颗星辰坠落地面。这次冲击造成魔法伤害并眩晕敌人，并且每命中一个敌方英雄还会提供星尘。收集足够的星尘后，奥瑞利安·索尔的下一次星落将会升级为天瀑。<br><br>天瀑：奥瑞利安 · 索尔从诸天拽下一颗巨大的星辰撞击地面，拥有提升过的冲击范围和提升过的伤害，并且会对敌人们造成击飞而非晕眩。随后会有一道冲击波从冲击范围的边缘散播出去，对命中的敌人们造成伤害和减速。星尘会提升【星落】和【天瀑】的冲击范围。（来源：官方中文静态资料16.17.1；数值和机制待补证，变量原样保留。）",
        "gameId": "lol",
        "maxLevel": 3,
        "name": "奥瑞利安·索尔·星天落瀑",
        "skillCategoryKeys": [],
        "skillKey": "aurelionsol_r",
