    "swain_e": {
      "route": "/skills/swain_e",
      "method": "GET",
      "status": 200,
      "ok": true,
      "data": {
        "createdAt": "2026-09-06T18:20:30.446795Z",
        "description": "斯维因释放一道恶魔之手向前击出。手臂随后会返回至斯维因处，并禁锢它命中的敌人。斯维因之后可以选择将所有被禁锢的英雄们拉拽得更靠近他。这个技能在【恶魔升华】期间会有一个更短的冷却时间。（来源：官方中文静态资料16.17.1；数值和机制待补证，变量原样保留。）",
        "gameId": "lol",
        "maxLevel": 5,
        "name": "斯维因·永不复行",
        "skillCategoryKeys": [
          "common"
