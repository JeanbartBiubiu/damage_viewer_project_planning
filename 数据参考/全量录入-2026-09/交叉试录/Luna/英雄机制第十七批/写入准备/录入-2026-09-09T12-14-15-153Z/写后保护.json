    "aurelionsol_w": {
      "route": "/skills/aurelionsol_w",
      "method": "GET",
      "status": 200,
      "ok": true,
      "data": {
        "createdAt": "2026-09-06T18:16:28.61679Z",
        "description": "奥瑞利安 · 索尔沿着目标方向飞越地形。在这个状态下，他可以施放其它技能。飞行期间，星河冲荡没有冷却时间，也没有最长蓄力时间，并且造成的伤害会提升。<br><br>如果有敌方英雄因为奥瑞利安 · 索尔近期造成的伤害阵亡，星穹流丽的冷却时间会缩短。<br><br>星尘会提升星穹流丽的最大飞行距离。（来源：官方中文静态资料16.17.1；数值和机制待补证，变量原样保留。）",
        "gameId": "lol",
        "maxLevel": 5,
        "name": "奥瑞利安·索尔·星穹流丽",
