{"skill":"ornn_p","text":{"keyName":{"sourceKey":"game_character_passiveName_Ornn","text":"活体锻炉"},"keySummary":{"sourceKey":"game_character_passiveDescription_Ornn","text":"奥恩可使所有来源的护甲和魔抗加成获得额外提升。<br><br>奥恩可在地图的任意位置上花费金钱来锻造非消耗品的装备。<br><br>此外，他能为他自己和友方英雄打造杰作武器。"},"keyTooltip":{"sourceKey":"Spell_OrnnP_Tooltip","text":"{{Spell_OrnnP_Tooltip_@GameModeInteger@}}"},"keyTooltipExtended":{"sourceKey":"Spell_OrnnP_TooltipExtended","text":"{{Spell_OrnnP_TooltipExtended_@GameModeInteger@}}"}},"spellCastTime":0,"values":[{"name":"MasterworkLevel","values":[13,13,13,13,13,13,13],"__type":"SpellDataValue"},{"name":"BaseStatAmp","values":[0.10000000149011612,0.10000000149011612,0.10000000149011612,0.10000000149011612,0.10000000149011612,0.10000000149011612,0.10000000149011612],"__type":"SpellDataValue"},{"name":"AdditionalMythicStatAmp","values":[0.03999999910593033,0.03999999910593033,0.03999999910593033,0.03999999910593033,0.03999999910593033,0.03999999910593033,0.03999999910593033],"__type":"SpellDataValue"},{"name":"GameModeInteger","values":[1,1,1,1,1,1,1],"__type":"SpellDataValue"},{"name":"UpgradeTotalGoldValue","values":[1000,1000,1000,1000,1000,1000,1000],"__type":"SpellDataValue"},{"name":"UpgradeADEff","values":[35,35,35,35,35,35,35],"__type":"SpellDataValue"},{"name":"UpgradeAPEff","values":[20,20,20,20,20,20,20],"__type":"SpellDataValue"},{"name":"UpgradeHPEff","values":[2.6600000858306885,2.6600000858306885,2.6600000858306885,2.6600000858306885,2.6600000858306885,2.6600000858306885,2.6600000858306885],"__type":"SpellDataValue"},{"name":"UpgradeAREff","values":[20,20,20,20,20,20,20],"__type":"SpellDataValue"},{"name":"UpgradeMREff","values":[18,18,18,18,18,18,18],"__type":"SpellDataValue"},{"name":"UpgradeAHEff","values":[31.25,31.25,31.25,31.25,31.25,31.25,31.25],"__type":"SpellDataValue"},{"name":"UpgradeASEff","values":[30,30,30,30,30,30,30],"__type":"SpellDataValue"}],"calculations":{"{7325018d}":{"mFormulaParts":[{"mStartValue":90,"mEndValue":10,"mScalePastDefau