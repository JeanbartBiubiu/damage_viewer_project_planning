      "data": {
        "createdAt": "2026-09-06T18:21:01.416062Z",
        "description": "维克托会在击杀一名敌人后获得海克斯碎片。每获得100个海克斯碎片，维克托将永久强化一个主动技能。升级完所有基础技能后，他可以再收集100个海克斯碎片，用来强化自己的终极技能。（来源：官方中文静态资料16.17.1；数值和机制待补证。）",
        "gameId": "lol",
        "maxLevel": 1,
        "name": "维克托·光荣进化",
        "skillCategoryKeys": [
          "passive"
        ],
        "skillKey": "viktor_p",
        "sortOrder": 0,
        "status": "ENABLED",
        "updatedAt": "2026-09-06T18:21:01.416062Z"
      }
    },
    "viktor_q": {
