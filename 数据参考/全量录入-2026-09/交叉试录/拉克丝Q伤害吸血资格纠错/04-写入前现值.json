    "/skills/lux_q/trigger-rules": [
      {
        "actionCount": 1,
        "conditionGroupCount": 1,
        "description": "监听 lux_q 实际命中后结算独立魔法伤害。不把命中事件写成束缚控制，也不表达第二目标筛选。",
        "eventType": "SKILL_HIT",
        "maxTriggersPerProcessEnabled": false,
        "name": "光之束缚实际命中结算",
        "perTargetCooldownEnabled": false,
        "ruleKey": "resolve_on_q_hit",
        "sortOrder": 10,
        "updatedAt": "2026-09-19T05:56:20.789721Z"
      },
      {
        "actionCount": 1,
        "conditionGroupCount": 0,
        "description": "每次本技能主动使用启动已有的使用过程；不定义完整施法时长，也不代替命中或其他未完成分支。",
        "eventType": "SKILL_USED",
        "maxTriggersPerProcessEnabled": false,
        "name": "主动使用启动光之束缚施法过程",
        "perTargetCooldownEnabled": false,
        "ruleKey": "on_used",
        "sortOrder": 20,
        "updatedAt": "2026-09-18T22:16:43.583719Z"
      },
      {
        "actionCount": 1,
        "conditionGroupCount": 1,
        "description": "只消费本技能实际敌方英雄命中，且同次护盾阻挡值为0、当前目标无本来源禁锢实例；缺失判定不能默认0。前两目标选择与碰撞不由本规则生成；每次合法实际命中分别检查。已有实例的重复命中未录，原伤害与其他组成保持。",
        "eventType": "SKILL_HIT",
        "maxTriggersPerProcessEnabled": false,
        "name": "拉克丝·光之束缚未受阻挡首次禁锢",
        "perTargetCooldownEnabled": false,
