          "keys": {
            "keyName": {
              "sourceKey": "Spell_GarenW_Name",
              "key": "spell_garenw_name",
              "text": "勇气"
            },
            "keySummary": {
              "sourceKey": "Spell_GarenW_Summary",
              "key": "spell_garenw_summary",
              "text": "盖伦被动地通过击杀敌人来提升护甲和魔法抗性。他也可以激活这个技能来暂时获得一层护盾和韧性，并在接下来的较长持续时间里获得较弱的伤害减免效果。"
            },
            "keyTooltip": {
              "sourceKey": "Spell_GarenW_Tooltip",
              "key": "spell_garenw_tooltip",
              "text": "<spellPassive>被动：</spellPassive>盖伦获得<scaleArmor>@ResistsForTooltip@额外护甲</scaleArmor>和<scaleMR>@ResistsForTooltip@额外魔法抗性</scaleMR>。击杀单位时会永久提供<attention>@ResistGainOnKillTooltip@双抗</attention>，至多至最大值<attention>@ResistMax@</attention>。<br><br><spellActive>主动：</spellActive>盖伦加固他的勇气@DRDuration@秒，使即将到来的伤害降低@DRPercent*100@%。他还会获得持续@UpfrontDuration@秒的<shield>@TotalShield@护盾值</shield>和<slow>@UpfrontTenacity*100@%韧性</slow>。"
            },
            "keyCost": {
              "sourceKey": "Spell_Cost_NoCost",
              "key": "spell_cost_nocost",
              "text": "无消耗"
            }
          }
        }
      },
