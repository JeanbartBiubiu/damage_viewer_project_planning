    "/skills/zyra_q": {
      "createdAt": "2026-09-06T18:21:27.412699Z",
      "description": "浓密的藤蔓在地面蔓延，并爆炸成棘刺，对范围内的敌人造成魔法伤害。如果在一颗种子附近施放，那么【Q致命棘刺】就会让种子长成一株荆棘喷射者，可对远处的敌人进行攻击。（来源：官方中文静态资料16.17.1；数值和机制待补证，变量原样保留。）",
      "gameId": "lol",
      "maxLevel": 5,
      "name": "婕拉·致命棘刺",
      "skillCategoryKeys": [
        "common"
      ],
      "skillKey": "zyra_q",
      "sortOrder": 1,
      "status": "ENABLED",
      "updatedAt": "2026-09-06T18:21:27.412699Z"
    },
