    "/skills/sivir_r": {
      "createdAt": "2026-09-06T18:20:24.003919Z",
      "description": "希维尔在战斗中引领她的友军，为他们提供持续一段时间的爆发性移动速度加成。此外，希维尔的攻击会缩短她的技能的冷却时间。（来源：官方中文静态资料16.17.1；数值和机制待补证，变量原样保留。）",
      "gameId": "lol",
      "maxLevel": 3,
      "name": "希维尔·狩猎",
