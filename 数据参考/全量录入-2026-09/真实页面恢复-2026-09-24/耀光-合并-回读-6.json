  "values": {
    "/skills/item_3057_passive": {
      "createdAt": "2026-09-07T16:06:31.681911Z",
      "description": "耀光咒刃造成来源基础攻击力1倍的额外物理伤害，冷却1500毫秒，数值沿用本物品冻结来源。本批有限模拟场景为普通成功首次主动施法且内部冷却就绪时开启10000毫秒待击；重复合格施法刷新完整窗口，不叠加次数。下一次强化普通攻击实际命中时一次消费，并从此时起算内部冷却；超时只清待命。窗口、刷新和冷却起算点为项目统一近似，不是游戏实测。重施、开关等特殊使用未验证；附伤已按项目口径核定吸血：生命偷取使用必要覆盖，全能吸血继承游戏规则；尚不代表完整装备运行。装备属性由装备本体提供。",
      "gameId": "lol",
      "maxLevel": 1,
      "name": "耀光·咒刃",
      "skillCategoryKeys": [
        "passive"
      ],
      "skillKey": "item_3057_passive",
      "sortOrder": 0,
      "status": "ENABLED",
      "updatedAt": "2026-09-24T04:54:44.89383Z"
    },
