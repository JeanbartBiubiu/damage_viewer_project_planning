  "values": {
    "/skills/chogath_w": {
      "createdAt": "2026-09-06T18:18:04.921171Z",
      "description": "科加斯向前方锥形区域发出声波，造成魔法伤害并沉默命中的敌人。已录入敌方英雄实际命中伤害、无本来源实例时的首次沉默，以及普通主动使用的法力消耗与基础冷却登记。五级伤害为80/130/180/230/280加0.7倍来源总法强，沉默1600/1700/1800/1900/2000毫秒。使用登记的立即步骤不表示零施放时长；完整施放时长和沉默重施仍待核。固定来源：客户端16.17、官方静态资料16.17.1。",
      "gameId": "lol",
      "maxLevel": 5,
      "name": "科加斯·野性尖叫",
      "skillCategoryKeys": [
        "common"
      ],
      "skillKey": "chogath_w",
      "sortOrder": 2,
      "status": "ENABLED",
      "updatedAt": "2026-09-19T18:03:04.184062Z"
    },
