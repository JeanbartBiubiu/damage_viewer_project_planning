    "manager": { "manager": 0, "frontend": 1, "backend": 1, "wasm": 1, "authoring": 1, "reviewer": 1 },
    "frontend": { "manager": 1, "frontend": 0, "backend": 1, "wasm": 1, "authoring": 0, "reviewer": 1 },
